<Window x:Class="Task1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="500">
    <DockPanel>
        <StackPanel DockPanel.Dock="Left">

            <Label Content="Тип ПО"></Label>
            <ComboBox Name="comboBox" Width="100" Height="20" IsEditable="False">
                <ComboBoxItem>Свободное</ComboBoxItem>
                <ComboBoxItem>Условно-бесплатное</ComboBoxItem>
                <ComboBoxItem>Коммерческое</ComboBoxItem>
            </ComboBox>

            <Label Content="Название"></Label>
            <TextBox Name="title" Width="100" Height="20" ></TextBox>
            <Label Content="Производитель"></Label>
            <TextBox Name="manufacturer" Width="100" Height="20"  ></TextBox>
            <Label Content="Дата установки"></Label>
            <TextBox Name="data" Width="100" Height="20"  ></TextBox>
            <Label Content="Срок работы"></Label>
            <TextBox Name="trialDays" Width="100" Height="20" ></TextBox>
            <Label Content="Цена"></Label>
            <TextBox Name="price" Width="100" Height="20" ></TextBox>

            <Button x:Name="button" Click="Button_Click" Width="100" Height="20" Content="Добавить"></Button>
            
        </StackPanel>

        <Label DockPanel.Dock="Right" Name="label"></Label>

    </DockPanel>
</Window>
