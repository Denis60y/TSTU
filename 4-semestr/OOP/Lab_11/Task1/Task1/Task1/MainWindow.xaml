<Window x:Class="Task1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>

        <StackPanel>
            <Label>Название товара:</Label>
            <TextBox Name="textBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="100" Height="30"></TextBox>
            <Label>Куплен:</Label>
            <CheckBox IsChecked="{Binding IsBought}" Margin="10, 0, 0, 10"></CheckBox>
            <Button Content="Добавить" Command="{Binding AddElementCommand}" Width="110" Height="30"></Button>
            <Button Content="Только купленные" Command="{Binding ShowOnlyBoughtCommand}" Width="110" Height="30"></Button>
            <Button Content="Только не &#10;купленные" Command="{Binding ShowOnlyNotBoughtCommand}" Width="110" Height="50"></Button>
            <Button Content="Показать все" Command="{Binding ShowAllCommand}" Width="110" Height="30"></Button>
        </StackPanel>
        
        <DataGrid ItemsSource="{Binding Products}" 
            AutoGenerateColumns="False" 
            CanUserAddRows="False"
            Width="400">
            <DataGrid.Columns>
                <DataGridTextColumn  Header="Товар" Binding="{Binding Name}" Width="200"/>
                <DataGridCheckBoxColumn Header="Куплено" Binding="{Binding IsBought}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
