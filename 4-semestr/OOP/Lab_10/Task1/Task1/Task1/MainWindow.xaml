<Window x:Class="Task1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        
        <SolidColorBrush x:Key="TableHeaderBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="TableBackgroundBrush" Color="#F5F5F5"/>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource TableHeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="30"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <StackPanel DockPanel.Dock="Left">
            <Label Width="110" Height="25" Margin="10,10,0,0">ФИО клиент:</Label>
            <TextBox x:Name="nameBox" Width="110" Height="20" Margin="10,0,0,0"></TextBox>

            <Label Width="110" Height="60" Margin="10,0,0,0" Content="Длительность &#10;абонемента &#10;(в месяцах):"></Label>
            <TextBox x:Name="abonementBox" Width="110" Height="20" Margin="10,0,0,0"></TextBox>

            <Label Width="110" Height="25" Margin="10,0,0,0">Тренер:</Label>
            <ComboBox x:Name="trainerBox" Width="110" Height="20" Margin="10,0,0,0" IsEditable="False">
                <ComboBoxItem>Сулейманов</ComboBoxItem>
                <ComboBoxItem>Нестёркин</ComboBoxItem>
                <ComboBoxItem>Попова</ComboBoxItem>
            </ComboBox>

            <Label Width="110" Height="43" Margin="10,0,0,0" Content="Программа&#10;тренировки:"></Label>
            <ComboBox x:Name="programmBox" Width="110" Height="20" Margin="10,0,0,0" IsEditable="False">
                <ComboBoxItem>База</ComboBoxItem>
                <ComboBoxItem>Кардио</ComboBoxItem>
                <ComboBoxItem>База+Кардио</ComboBoxItem>
            </ComboBox>


            <Button x:Name="button1" Width="110" Height="40" Content="Добавить клиента" Margin="10,10,0,10" Click="button1_Click"/>

        </StackPanel>


        <DataGrid DockPanel.Dock="Right" x:Name="MyDataGrid" CanUserAddRows="True" AutoGenerateColumns="False" Margin="20,10,10,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="30.0"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Абонемент" Binding="{Binding Abonement}" Width="*"/>
                <DataGridTextColumn Header="Программа" Binding="{Binding Programm}" Width="*"/>
                <DataGridTextColumn Header="Тренер" Binding="{Binding Trainer}" Width="*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>

</Window>
